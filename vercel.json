{
  "rewrites": [
    {
      "source": "/proxy-home",
      "destination": "https://id.welib.org/"
    },
    {
      "source": "/md5/:path*",
      "destination": "https://id.welib.org/md5/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://id.welib.org/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://id.welib.org/:path*"
    }
  ]
}
